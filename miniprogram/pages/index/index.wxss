/* 首页 */

/* ---------- 配置未完成 ---------- */

.setup {
  margin-top: 40rpx;
}

.setup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #14453d;
  margin-bottom: 16rpx;
}

.setup-text {
  font-size: 27rpx;
  color: #5c6b66;
  line-height: 1.7;
}

.setup-file {
  margin: 18rpx 0;
  padding: 16rpx 20rpx;
  background: #f4f6f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #c77e22;
  font-family: monospace;
}

/* ---------- 输入卡片 ---------- */

.counter {
  font-size: 26rpx;
  color: #9aa5a1;
  font-variant-numeric: tabular-nums;
}

.counter-max {
  color: #c6483f;
  font-weight: 600;
}

.editor {
  width: 100%;
  height: 420rpx;
  margin-top: 20rpx;
  padding: 22rpx;
  box-sizing: border-box;
  background: #f7f9f8;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: #1f2a26;
}

.editor-ph {
  color: #a8b2ae;
  font-size: 29rpx;
}

.editor-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.editor-actions .link-btn {
  margin-left: 12rpx;
}

/* ---------- 改写参数选择器 ---------- */

.params {
  padding: 22rpx 28rpx;
}

.param-row {
  display: flex;
  align-items: center;
}

.param-row + .param-row {
  margin-top: 18rpx;
}

.param-label {
  width: 72rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: #7b8783;
}

.segs {
  display: flex;
  flex: 1;
  min-width: 0;
  background: #f4f6f5;
  border-radius: 14rpx;
  padding: 6rpx;
}

.seg {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #5c6b66;
  transition: background 0.15s, color 0.15s;
}

.seg-active {
  background: #fff;
  color: #14453d;
  font-weight: 600;
  box-shadow: 0 1rpx 6rpx rgba(20, 69, 61, 0.1);
}

/* ---------- 提交按钮 ---------- */

.submit {
  margin-top: 28rpx;
}

.submit-loading {
  display: flex;
  align-items: center;
}

.dot {
  font-size: 20rpx;
  margin-right: 12rpx;
  opacity: 0.7;
}

/* ---------- 额度 ---------- */

.quota {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #7b8783;
}

.quota-reset {
  margin-left: 12rpx;
  color: #c77e22;
}

.foot-hint {
  margin-top: 36rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a8b2ae;
  line-height: 1.7;
}
