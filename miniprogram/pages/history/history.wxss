/* 历史记录 */

.head {
  padding: 4rpx 8rpx 20rpx;
}

.item {
  padding: 24rpx 28rpx;
}

.item-hover {
  background: #fafcfb;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-score {
  font-size: 36rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.item-unit {
  font-size: 22rpx;
  color: #8a9490;
  margin: 0 12rpx 0 2rpx;
}

.item-chip {
  margin-top: 4rpx;
}

.item-time {
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 原文 → 结果：两行各一句，超长省略。中间那个 ↓ 是「转换」的标志 */
.pair {
  margin-top: 14rpx;
}

.pair-row {
  display: flex;
  align-items: center;
}

.pair-tag {
  flex-shrink: 0;
  width: 68rpx;
  font-size: 22rpx;
  color: #a8b2ae;
}

.pair-tag-out {
  color: #2e8b6e;
}

/* 单行省略：flex 子项必须 min-width:0，光写 overflow 是裁不掉的 */
.pair-text {
  display: block;
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  line-height: 1.5;
  color: #7b8783;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pair-text-out {
  color: #1f2a26;
}

.pair-text-empty {
  color: #b9c2be;
}

/* 箭头对着文字这一列，读起来就是「上一行的结果」 */
.pair-arrow {
  margin: 2rpx 0 2rpx 68rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #2e8b6e;
}

.item-foot {
  margin-top: 14rpx;
  font-size: 24rpx;
}

.list-hint {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
}
